# 复制本文件为 .env 并填入你的 DeepSeek API Key
# 获取 Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的key

# 可选：切换模型（2026-08 官方名：flash 快而便宜 / pro 更强）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：上下文管理两件套的阈值
# SPILL_MAX_INLINE=2000    # 单个工具结果超过多少字符就 spill（完整原文落盘，模型只看头尾预览）
# COMPACT_THRESHOLD=4000   # 估算 token 超过多少就把旧历史摘要压缩（实验时可调小来观察效果）
